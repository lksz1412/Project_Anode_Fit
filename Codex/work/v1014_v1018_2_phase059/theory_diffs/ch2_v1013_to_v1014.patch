 \begin{equation}
-\avg{n} \;=\; \frac{0\cdot 1 + 1\cdot e^{-\beta(\varepsilon_0-\mu)}}{Z_1}
+\avg{n} \;=\; \frac{0\cdot 1 + 1\cdot e^{-\beta(\varepsilon_0-\mu)}}{\Xi_1}
 \;=\; \frac{e^{-\beta(\varepsilon_0-\mu)}}{1+e^{-\beta(\varepsilon_0-\mu)}}
 \;=\; \frac{1}{1+e^{\beta(\varepsilon_0-\mu)}}.
 \label{eq:occ}
